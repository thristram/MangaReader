{
  "name": "@mangareader/server",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/dev.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "db:migrate": "node --env-file=.env --import tsx src/migrate.ts"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "express": "5.3.0",
    "mongodb": "7.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "jose": "^6.0.0",
    "supertest": "7.3.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
