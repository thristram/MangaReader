# Copy to .env. Credentials stay in this server only.
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=mangareader
AUTH_ISSUER=https://auth.example.com/api/auth
AUTH_JWKS_URL=https://auth.example.com/api/auth/jwks
# Permanent registered resource identifier, not an OAuth client ID.
MANGA_API_AUDIENCE=https://manga.example.com
# Optional opaque-token introspection; confidential API client, never native client.
AUTH_INTROSPECTION_CLIENT_ID=
AUTH_INTROSPECTION_CLIENT_SECRET=
