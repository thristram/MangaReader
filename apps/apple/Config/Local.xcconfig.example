// Copy to Local.xcconfig. These public app values are not secrets.
// Deployment URLs/resource are configured in Service.xcconfig.
MAC_OAUTH_CLIENT_ID = replace-with-registered-mac-client-id
IPHONE_OAUTH_CLIENT_ID = replace-with-registered-iphone-client-id
// Fixed development callback schemes; register exact redirect URIs.
// com.thristram.mangareader.mac:/oauth/callback
// com.thristram.mangareader.iphone:/oauth/callback
